# Missile Wars shard — environment template.
#
# Docker hosts: do NOT copy this by hand. Run ./docker/setup.sh, which
# generates .env with unique local secrets (Postgres password, JWT secret).
#
# Only "safe" values belong here. A shard never holds Firebase admin
# credentials, a shared DATABASE_URL, or JWT *signing* keys — see
# DISTRIBUTED_HOSTING_PLAN.md.

# Public port the shard listens on.
PORT=8080

# Local Postgres, used only by this shard's docker-compose stack.
POSTGRES_USER=missilewars
POSTGRES_DB=missilewars
POSTGRES_PASSWORD=generated-by-docker/setup.sh

# Local JWT secret — required only for solo/local hosting (no coordinator).
# When COORDINATOR_URL + SHARD_API_KEY are set, tokens are minted and verified
# via the coordinator (RS256/JWKS) and this is only kept to honor old HS256
# sessions during migration; drop it after 30 days.
JWT_SECRET=generated-by-docker/setup.sh

# ON for chatty logs.
VERBOSE_MODE=OFF

# --- Distributed hosting ---
# Coordinator base URL, the shard-scoped API key issued at registration, and
# this shard's id (used as the JWT audience check so tokens minted for other
# shards are rejected here). All written by docker/host.sh|ps1 registration;
# all safe for the host to read, and the API key is revocable.
#COORDINATOR_URL=https://coordinator.example.com
#SHARD_API_KEY=
#SHARD_ID=

# Optional commit SHA reported in heartbeats (set by your build/CI).
#GIT_SHA=

# Phase 12 self-update. When a coordinator is configured, the shard checks for
# new backend releases on each 30s heartbeat and runs docker/update.sh|ps1 to
# update itself (at a quiet moment — no players connected, unless the release is
# marked critical). Set AUTO_UPDATE=false to opt out and update manually; the
# coordinator may still hide outdated shards from player discovery.
#AUTO_UPDATE=true

# --- Owner deployment only (never community shards) ---
# firebasecred.json in the repo root enables: the global chat message
# listener, Firebase Storage profile images, and Firebase account-management
# ops (password/email changes). Community shards run WITHOUT it: ID-token
# login verifies via the coordinator, pushes go through the coordinator's
# /relay/push, and those account-management endpoints are unavailable.

# --- Optional: password-reset emails (owner deployment only) ---
#EMAIL_HOST=
#EMAIL_PORT=587
#EMAIL_SECURE=false
#EMAIL_USER=
#EMAIL_PASS=
#EMAIL_FROM=

# --- Non-Docker (bare metal) only ---
# Docker builds DATABASE_URL from the POSTGRES_* parts automatically.
#DATABASE_URL=postgresql://user:password@localhost:5432/missilewars
